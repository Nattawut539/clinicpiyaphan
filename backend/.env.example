PORT=5000
NODE_ENV=production

# Frontend URLs allowed to call this API.
FRONTEND_URL=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com
TRUST_PROXY=1

# Keep lax when the frontend proxies /api (recommended). Cookies are always
# Secure when NODE_ENV=production. COOKIE_DOMAIN is normally left empty.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Use a long random value in production.
JWT_SECRET=change-this-to-a-long-random-secret

# PostgreSQL. Use either DATABASE_URL or the separate DB_* variables below,
# never both. Supabase pooler usernames include the project suffix.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Optional schema-owner connection, used only by `npm run migrate`.
MIGRATION_DATABASE_URL=
PGSSL=true
PG_MAX=10
PG_IDLE=3000
PG_CONNECT_TIMEOUT=5000
PG_APP=clinic-api

# Use google_drive for durable uploads on Render Free. Local storage is ephemeral.
STORAGE_PROVIDER=local
UPLOAD_DIR=
# Set false after all legacy local images have been migrated and verified.
SERVE_LEGACY_UPLOADS=true
# Used only for STORAGE_PROVIDER=google_drive. Keep these secrets on the backend.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
DOCTOR_IMAGE_DRIVE_ID=
# Only use this for platforms where losing uploaded files is acceptable.
ALLOW_EPHEMERAL_UPLOADS=false

# Production defaults to false. Run `npm run migrate` as a release/pre-deploy command.
RUN_MIGRATIONS_ON_START=false

# If not using DATABASE_URL, set these instead.
DB_USER=cliniccare_runtime.your-project-ref
# Copy the exact Session pooler host from Supabase Dashboard > Connect.
DB_HOST=your-pooler-host.pooler.supabase.com
DB_NAME=postgres
DB_PASSWORD=use-a-long-random-password
DB_PORT=5432

# Mail provider.
SMTP_HOST=smtp.example.com
# Render Free blocks SMTP ports 25, 465 and 587. Use a provider endpoint on
# another supported port (commonly 2525), or upgrade the Render instance.
SMTP_PORT=2525
SMTP_USER=mail@example.com
SMTP_PASS=change-this
MAIL_FROM=mail@example.com
RESET_TOKEN_EXPIRE_MIN=10
DISABLE_EMAIL=false

# Google OAuth. Callback URL must match provider settings.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-frontend.example.com/api/google/callback
GOOGLE_SCOPES=openid email profile
DISABLE_GOOGLE_OAUTH=false

# LINE OAuth. Callback URL must match provider settings.
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_REDIRECT_URI=https://your-frontend.example.com/api/line/callback
LINE_SCOPES=openid profile email
DISABLE_LINE_OAUTH=false

# Google reCAPTCHA v2 Checkbox. Keep the secret on the backend only.
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=your-frontend.example.com

# Hardware scale integration. Keep disabled until the broker and database
# migration are ready. Production must use mqtts://.
MQTT_ENABLED=false
MQTT_URL=mqtts://mqtt.example.com:8883
MQTT_CLIENT_ID=clinic-backend-production
MQTT_USERNAME=clinic_backend
MQTT_PASSWORD=replace-with-a-long-random-secret
MQTT_CA_FILE=
MQTT_CERT_FILE=
MQTT_KEY_FILE=
MQTT_TOPIC_PREFIX=clinic/v1
MQTT_QOS=1
MQTT_RECONNECT_PERIOD_MS=5000
MQTT_REJECT_UNAUTHORIZED=true
