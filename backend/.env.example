PORT=5000
NODE_ENV=production

# Frontend URLs allowed to call this API.
FRONTEND_URL=https://your-frontend.example.com
CORS_ORIGINS=https://your-frontend.example.com

# Use a long random value in production.
JWT_SECRET=change-this-to-a-long-random-secret

# PostgreSQL. Prefer DATABASE_URL on cloud platforms.
DATABASE_URL=postgresql://user:password@host:5432/database
PGSSL=true
PG_MAX=10
PG_IDLE=3000
PG_CONNECT_TIMEOUT=5000
PG_APP=clinic-api

# If not using DATABASE_URL, set these instead.
DB_USER=postgres
DB_HOST=localhost
DB_NAME=projectfinal
DB_PASSWORD=change-this
DB_PORT=5432

# Mail provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mail@example.com
SMTP_PASS=change-this
MAIL_FROM=mail@example.com
RESET_TOKEN_EXPIRE_MIN=10

# Google OAuth. Callback URL must match provider settings.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend.example.com/api/google/callback

# LINE OAuth. Callback URL must match provider settings.
LINE_CHANNEL_ID=your-line-channel-id
LINE_CHANNEL_SECRET=your-line-channel-secret
LINE_REDIRECT_URI=https://your-backend.example.com/api/line/callback
