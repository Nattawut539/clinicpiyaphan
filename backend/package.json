{
  "name": "backend",
  "version": "1.0.0",
  "description": "ClinicCare API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:render": "npm run check:deploy && node server.js",
    "dev": "nodemon server.js",
    "migrate": "node tools/migrate.js",
    "check:deploy": "node tools/preflight.js",
    "check:integrations": "node tools/checkIntegrations.js",
    "check:integrations:smtp": "node tools/checkIntegrations.js --verify-smtp",
    "check:integrations:strict": "node tools/checkIntegrations.js --require-all",
    "check:integrations:live": "node tools/checkIntegrations.js --require-all --verify-smtp --verify-storage --verify-mqtt",
    "test:audit": "node tests/advisor-audit.js",
    "test:requirements-schema": "node tests/requirements-schema.js",
    "test:requirements-api": "node tests/requirements-api-smoke.js",
    "test:requirements-workflow": "node tests/requirements-workflow.js",
    "test:google-profile": "node tests/google-profile-workflow.js",
    "test:medical-date-lock": "node tests/medical-date-lock-workflow.js",
    "test:checkin-phone": "node tests/checkin-phone-search-smoke.js",
    "test:password-reset": "node tests/password-reset-workflow.js",
    "migrate:profile-images": "node tools/migrateProfileImagesToFiles.js",
    "check:storage": "node tools/checkStorage.js",
    "migrate:profile-images:drive": "node tools/migrateProfileImagesToDrive.js",
    "check:profile-images:drive": "node tools/checkProfileImageMigration.js",
    "cleanup:profile-images": "node tools/cleanupProfileImages.js",
    "test:profile-images": "node --test tests/profile-images.test.js",
    "test:recaptcha": "node --test tests/recaptcha.test.js",
    "test:mqtt-bridge": "node --test tests/mqtt-bridge.test.js",
    "tool:hardware": "node tools/hardwareTestCli.js",
    "tool:hardware:smoke": "node tools/hardwareTestSmoke.js",
    "test:hardware-tool": "node --test tests/hardware-test-tool.test.js",
    "test:hardware-reliability": "node --test tests/hardware-software-reliability.test.js tests/print-outbox.test.js tests/print-retry-policy.test.js",
    "test:hardware-schema": "node tests/hardware-reliability-schema.js",
    "test:hardware-sql": "node tests/hardware-reliability-sql-smoke.js",
    "test:profile-images-workflow": "node tests/profile-images-workflow.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "googleapis": "^178.1.1",
    "jsonwebtoken": "^9.0.2",
    "mqtt": "^5.14.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "aedes": "^1.1.2",
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
