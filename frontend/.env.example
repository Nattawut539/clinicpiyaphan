# Backend API root. Both formats below are supported; prefer the /api form.
NEXT_PUBLIC_API_BASE=https://your-backend.example.com/api

# Optional, only needed when reCAPTCHA is enabled on login/register.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Optional. Used by /users/userHome to render Google Maps Embed API.
# If empty, the page falls back to a no-key Google Maps embed URL.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=your-google-maps-embed-api-key
