# Browser traffic stays on the frontend origin and is proxied by Next.js.
NEXT_PUBLIC_API_BASE=/api

# Backend destination for Next.js rewrites and middleware. Set BACKEND_INTERNAL_URL
# as well when your platform provides a private service URL.
BACKEND_ORIGIN=https://your-backend.example.com
BACKEND_INTERNAL_URL=https://your-backend.example.com

# Public reCAPTCHA v2 site key. The matching secret belongs only in the backend.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# Optional. Used by /users/userHome to render Google Maps Embed API.
# If empty, the page falls back to a no-key Google Maps embed URL.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=your-google-maps-embed-api-key
