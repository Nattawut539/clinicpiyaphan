# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/frontend/node_modules
/backend/node_modules
/frontend/.npm-cache/
/backend/.npm-cache/
/backend/.hardware-test/
/.local-backups/
/frontend/.next
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.vscode/
/.codesight/
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
/backend/.env
/backend/uploads/*
!/backend/uploads/.gitkeep
.env
.env*
!.env.example
!**/.env.example



# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local supporting documents; excluded from the submitted repository.
/docs/
/reports/
# Historical upgrade script retained locally; the repository uses schema.sql.
/database/migrations.sql
